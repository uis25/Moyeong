[
  { "id": "sample-r01", "policyId": "mafra-young-farmer-settlement", "authorId": "sample-01", "rating": 4, "keywords": ["지원이 도움됐어요", "서류가 복잡해요"], "content": "매달 들어오는 정착지원금 덕분에 첫해 생활비 걱정을 덜고 농사에 집중할 수 있었어요. 다만 영농계획서와 소득 확인 서류를 준비하는 데 시간이 꽤 걸렸고, 건강보험료 기준은 미리 확인해 두는 게 좋아요.", "createdAt": "2025-09-14", "updatedAt": "2025-09-14" },
  { "id": "sample-r02", "policyId": "mafra-young-farmer-settlement", "authorId": "sample-02", "rating": 5, "keywords": ["지원이 도움됐어요", "설명이 친절해요"], "content": "시청 담당자분이 독립경영 요건을 차근차근 설명해 주셔서 헷갈리던 부분이 풀렸어요. 정착지원금과 함께 농지 임대 우선지원도 연계돼서 땅 구하는 부담이 줄었습니다.", "createdAt": "2025-06-03", "updatedAt": "2025-06-03" },
  { "id": "sample-r03", "policyId": "mafra-young-farmer-settlement", "authorId": "sample-03", "rating": 3, "keywords": ["자격 확인이 어려워요", "서류가 복잡해요"], "content": "부모님과 같은 세대로 묶여 있어서 건강보험료 기준을 따지는 게 제일 헷갈렸어요. 독립 영농경력을 언제부터 세는지도 직접 문의해서 확인해야 했습니다.", "createdAt": "2025-11-22", "updatedAt": "2025-11-22" },
  { "id": "sample-r04", "policyId": "mafra-young-farmer-settlement", "authorId": "sample-04", "rating": 4, "keywords": ["지원이 도움됐어요", "준비 기간이 길어요"], "content": "공고가 나기 전부터 경영체 등록과 영농 계획을 미리 준비해 둔 게 큰 도움이 됐어요. 선발된 뒤에는 후계농자금까지 이어서 알아볼 수 있었어요.", "createdAt": "2026-01-08", "updatedAt": "2026-01-08" },
  { "id": "sample-r05", "policyId": "mafra-young-farmer-settlement", "authorId": "sample-05", "rating": 2, "keywords": ["준비 기간이 길어요", "자격 확인이 어려워요"], "content": "작년에 준비해서 냈는데 소득 기준을 넘어서 대상이 안 됐어요. 신청 전에 본인 세대 건강보험료부터 확인했으면 시간을 아꼈을 것 같아요.", "createdAt": "2025-08-30", "updatedAt": "2025-08-30" },
  { "id": "sample-r06", "policyId": "mafra-young-farmer-settlement", "authorId": "sample-06", "rating": 5, "keywords": ["신청이 쉬워요", "지원이 도움됐어요"], "content": "신청서는 온라인으로 내고 나머지는 안내받은 서류만 챙기면 돼서 생각보다 수월했어요. 지원받는 동안 시설 투자 계획을 여유 있게 세울 수 있었습니다.", "createdAt": "2026-03-17", "updatedAt": "2026-03-17" },
  { "id": "sample-r07", "policyId": "mafra-young-farmer-settlement", "authorId": "sample-07", "rating": 4, "keywords": ["설명이 친절해요", "서류가 복잡해요"], "content": "어디에 서류를 내야 하는지 몰라 헤맸는데 시청에 전화하니 바로 알려 주셨어요. 증빙 서류 종류가 많으니 목록을 뽑아 두고 하나씩 체크하세요.", "createdAt": "2026-05-28", "updatedAt": "2026-05-28" },

  { "id": "sample-r08", "policyId": "jeju-seogwipo-smartfarm-basic-2026", "authorId": "sample-08", "rating": 5, "keywords": ["설명이 친절해요", "신청이 쉬워요"], "content": "전화 한 통으로 접수가 끝나서 편했어요. 스마트팜 기초 이론부터 농장 전기 회로 실습까지 강사님이 하나하나 짚어 주셔서, 전기를 전혀 모르던 저도 따라갈 수 있었어요.", "createdAt": "2025-07-02", "updatedAt": "2025-07-02" },
  { "id": "sample-r09", "policyId": "jeju-seogwipo-smartfarm-basic-2026", "authorId": "sample-09", "rating": 4, "keywords": ["지원이 도움됐어요", "자격 확인이 어려워요"], "content": "우수 농가 견학에서 실제 환경 제어 장비를 보니 감이 확 왔어요. 다만 관내 농업인만 받는 교육이라 제 주소지가 해당되는지 센터에 먼저 물어봐야 했어요.", "createdAt": "2025-06-25", "updatedAt": "2025-06-25" },
  { "id": "sample-r10", "policyId": "jeju-seogwipo-smartfarm-basic-2026", "authorId": "sample-10", "rating": 3, "keywords": ["준비 기간이 길어요", "설명이 친절해요"], "content": "교육이 몇 주에 걸쳐 있어서 밭일과 겹치는 날은 일정 맞추기가 쉽지 않았어요. 그래도 질문은 편하게 받아 주셔서 내용은 알찼어요.", "createdAt": "2025-07-10", "updatedAt": "2025-07-10" },
  { "id": "sample-r11", "policyId": "jeju-seogwipo-smartfarm-basic-2026", "authorId": "sample-11", "rating": 4, "keywords": ["신청이 쉬워요"], "content": "선착순이라 접수 첫날 아침에 바로 전화했어요. 전동기 회로 실습은 처음엔 어려웠는데, 집에 와서 하우스 배선을 다시 들여다보게 되더라고요.", "createdAt": "2025-06-30", "updatedAt": "2025-06-30" },

  { "id": "sample-r12", "policyId": "mafra-gatsaeng-internship-2026", "authorId": "sample-12", "rating": 5, "keywords": ["지원이 도움됐어요", "신청이 쉬워요"], "content": "푸드테크 기업에서 3주 동안 실제 프로젝트를 맡아 보니 농업 쪽 진로가 훨씬 구체적으로 그려졌어요. 누리집에서 신청하는 과정도 간단했어요.", "createdAt": "2025-08-12", "updatedAt": "2025-08-12" },
  { "id": "sample-r13", "policyId": "mafra-gatsaeng-internship-2026", "authorId": "sample-13", "rating": 3, "keywords": ["준비 기간이 길어요", "지원이 도움됐어요"], "content": "참여 기업이 모두 육지에 있어서 제주에서 가려니 숙소와 이동편을 미리 알아보느라 바빴어요. 활동비가 나와 부담은 덜했지만 일정은 일찍 정해 두는 게 좋아요.", "createdAt": "2025-08-20", "updatedAt": "2025-08-20" },
  { "id": "sample-r14", "policyId": "mafra-gatsaeng-internship-2026", "authorId": "sample-14", "rating": 4, "keywords": ["설명이 친절해요", "자격 확인이 어려워요"], "content": "기업 담당자분들이 업무를 차근차근 알려 주셔서 금방 적응했어요. 나이 기준이 어느 날짜를 기준으로 하는지 헷갈려서 따로 문의했으니, 공고를 꼼꼼히 보세요.", "createdAt": "2025-09-02", "updatedAt": "2025-09-02" },
  { "id": "sample-r15", "policyId": "mafra-gatsaeng-internship-2026", "authorId": "sample-15", "rating": 4, "keywords": ["신청이 쉬워요", "서류가 복잡해요"], "content": "지원서 자체는 간단했는데 선발된 뒤에 내야 하는 서류가 몇 가지 더 있었어요. 스마트팜 기업 현장을 직접 볼 수 있어서 좋았습니다.", "createdAt": "2025-08-28", "updatedAt": "2025-08-28" },

  { "id": "sample-r16", "policyId": "mafra-youth-startup-scholarship-2026-2h", "authorId": "sample-16", "rating": 2, "keywords": ["자격 확인이 어려워요", "준비 기간이 길어요"], "content": "학교 추천과 서류 심사, 보증보험 가입까지 단계가 많아서 생각보다 오래 걸렸어요. 졸업 후 의무종사 기간 조건을 처음엔 제대로 몰랐는데, 신청 전에 꼭 꼼꼼히 읽어 보세요.", "createdAt": "2026-02-20", "updatedAt": "2026-02-20" },
  { "id": "sample-r17", "policyId": "mafra-youth-startup-scholarship-2026-2h", "authorId": "sample-17", "rating": 5, "keywords": ["지원이 도움됐어요", "신청이 쉬워요"], "content": "등록금 부담이 줄어서 아르바이트 대신 실습 농장에 더 시간을 쓸 수 있었어요. 재단 누리집 신청 화면이 단계별로 나뉘어 있어서 어렵지 않았어요.", "createdAt": "2025-09-25", "updatedAt": "2025-09-25" },
  { "id": "sample-r18", "policyId": "mafra-youth-startup-scholarship-2026-2h", "authorId": "sample-18", "rating": 4, "keywords": ["설명이 친절해요", "서류가 복잡해요"], "content": "학과 사무실에서 학교 추천 절차를 친절하게 안내해 줬어요. 성적과 이수학점 증빙, 보증보험 서류까지 챙길 게 많으니 학기 초부터 준비하세요.", "createdAt": "2026-03-10", "updatedAt": "2026-03-10" },

  { "id": "sample-r19", "policyId": "jeju-dongbu-young-farmer-studygroup-2026", "authorId": "sample-19", "rating": 5, "keywords": ["지원이 도움됐어요", "설명이 친절해요"], "content": "감귤 농사짓는 친구들과 그룹을 만들어 원하는 강사를 직접 초빙할 수 있었던 게 가장 좋았어요. 센터 담당자분이 운영 방법을 처음부터 잘 잡아 주셨어요.", "createdAt": "2025-10-15", "updatedAt": "2025-10-15" },
  { "id": "sample-r20", "policyId": "jeju-dongbu-young-farmer-studygroup-2026", "authorId": "sample-20", "rating": 4, "keywords": ["신청이 쉬워요", "서류가 복잡해요"], "content": "같이 할 사람만 모이면 신청은 어렵지 않아요. 개인용 신청서와 서약서, 그룹용 신청서를 따로 내야 해서 팀원 서류 모으는 게 일이었어요.", "createdAt": "2025-04-28", "updatedAt": "2025-04-28" },
  { "id": "sample-r21", "policyId": "jeju-dongbu-young-farmer-studygroup-2026", "authorId": "sample-21", "rating": 3, "keywords": ["준비 기간이 길어요", "자격 확인이 어려워요"], "content": "제주로 이사 온 지 얼마 안 돼서 저는 거주 기간 기준에 맞는지부터 확인해야 했어요. 팀원을 모으고 공부할 주제를 정하는 데도 생각보다 시간이 걸렸어요.", "createdAt": "2026-04-20", "updatedAt": "2026-04-20" },

  { "id": "sample-r22", "policyId": "jeju-agri-youth-ceo-course-2026", "authorId": "sample-22", "rating": 5, "keywords": ["지원이 도움됐어요", "설명이 친절해요"], "content": "사업계획서를 직접 써 보는 수업 덕분에 막연하던 가공품 계획이 정리됐어요. AI로 상품 홍보 문구와 이미지를 만드는 실습도 지금 바로 써먹고 있어요.", "createdAt": "2025-09-30", "updatedAt": "2025-09-30" },
  { "id": "sample-r23", "policyId": "jeju-agri-youth-ceo-course-2026", "authorId": "sample-23", "rating": 4, "keywords": ["신청이 쉬워요", "준비 기간이 길어요"], "content": "선착순이라 접수일에 서둘렀는데, 경영체 등록확인서만 있으면 신청은 간단했어요. 교육이 두 달 넘게 이어져서 농번기와 겹치는 날은 일정 조정이 필요했어요.", "createdAt": "2025-07-20", "updatedAt": "2025-07-20" }
]
